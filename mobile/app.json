{
  "expo": {
    "name": "FinChat",
    "slug": "finchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "finchat",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0F110E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.finchat.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F110E"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.finchat.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F110E",
          "dark": {
            "backgroundColor": "#0F110E"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
